# Pre-commit gate (Husky v9 — plain shell).
#
# Purpose: never let code with broken TypeScript, a duplicate property, or a
# broken Nest DI graph reach main. The motion.ts duplicate-property trap
# already took a server down once.
#
# WHY THIS IS SCOPED AND NOT `pnpm build`
# ----------------------------------------
# The root `pnpm build` is a Turborepo fan-out across every workspace. It is
# the correct release gate, but it is slower and broader than a pre-commit
# check needs to be. This hook validates the API quickly:
#   1. lint-staged  — eslint on staged API sources
#   2. tsc --noEmit — a FULL API typecheck (not just staged files), which is
#                     what catches duplicate properties
#   3. nest build   — validates decorators + the DI graph, which tsc does not
#
# The web suite and root build remain required manual release gates:
#   pnpm --filter web test
#   pnpm build

echo "[pre-commit] lint-staged (staged API sources)"
pnpm exec lint-staged
if [ $? -ne 0 ]; then
  echo "[pre-commit] FAILED: lint-staged"
  exit 1
fi

echo "[pre-commit] typecheck: api (full project, not just staged files)"
pnpm --filter api exec tsc --noEmit -p tsconfig.json
if [ $? -ne 0 ]; then
  echo "[pre-commit] FAILED: TypeScript errors in apps/api. Fix locally, then commit."
  exit 1
fi

echo "[pre-commit] build: api (decorator + DI graph validation)"
pnpm --filter api run build
if [ $? -ne 0 ]; then
  echo "[pre-commit] FAILED: apps/api build. Fix locally, then commit."
  exit 1
fi

echo "[pre-commit] OK"
