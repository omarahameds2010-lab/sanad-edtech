# ---------------------------------------------------------------------------
# SANAD API — local development template
# Copy to apps/api/.env and fill in real local values. Never commit .env.
# ---------------------------------------------------------------------------

# Database
# Runtime user (app_user) — no superuser, no BYPASSRLS.
DATABASE_URL="postgresql://app_user:app_user_password@localhost:5432/learning_platform?schema=public"

# Migration/owner connection — only for prisma migrate and seeding.
# Do NOT set this in the Railway runtime service after RLS activation.
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learning_platform?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"
# The refresh token is opaque and lasts 7 days; it is not configured by JWT_EXPIRES_IN.
COOKIE_SECURE="true"
COOKIE_SAMESITE="strict"

# Redis (dependencies exist; no Bull processors are registered yet)
REDIS_HOST="localhost"
REDIS_PORT="6379"

# CORS / CSRF
# Must match the exact ASCII web origin. Do not add invisible Unicode marks.
ALLOWED_ORIGINS="http://localhost:3001"
APP_URL="http://localhost:3001"

# Server
NODE_ENV="development"
PORT=3002
LOG_LEVEL="info"

# Paymob — enabled only when API key, integration id, and HMAC secret are present.
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_IFRAME_ID=""
PAYMOB_HMAC_SECRET=""
PAYMOB_BASE_URL="https://accept.paymob.com/api"

# Fawry — enabled only when merchant code, secret key, and secure hash key are present.
FAWRY_MERCHANT_CODE=""
FAWRY_SECRET_KEY=""
FAWRY_SECURE_HASH_KEY=""
FAWRY_BASE_URL="https://atfawry.fawrystaging.com"

# Payment scaffolding — fail-closed, not live payment methods.
# They require an explicit payment.providers entry to activate.
INSTAPAY_ENABLED="false"
INSTAPAY_BASE_URL=""
INSTAPAY_CLIENT_ID=""
INSTAPAY_CLIENT_SECRET=""
INSTAPAY_CERTIFICATE=""

VODAFONE_CASH_ENABLED="false"
VODAFONE_CASH_BASE_URL=""
VODAFONE_CASH_MERCHANT_ID=""
VODAFONE_CASH_API_KEY=""
VODAFONE_CASH_SECRET=""

EAND_MONEY_ENABLED="false"
EAND_MONEY_BASE_URL=""
EAND_MONEY_CLIENT_ID=""
EAND_MONEY_CLIENT_SECRET=""
EAND_MONEY_MERCHANT_ID=""

# Video security — MUST be changed in production.
VIDEO_WATERMARK_HMAC_SECRET="replace-with-a-long-random-secret"
VIDEO_TOKEN_SECRET="replace-with-a-long-random-secret"
VIDEO_TOKEN_ISSUER="learning-platform"
VIDEO_TOKEN_TTL_MS="300000"
VIDEO_DEFAULT_PROVIDER="bunny"
WATERMARK_POSITION_CHANGE_INTERVAL_SEC="7"

# Bunny Stream — optional. Current demo uses an unlisted YouTube id instead.
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_CDN_HOSTNAME=""
BUNNY_STREAM_SIGNING_KEY=""
BUNNY_STREAM_BASE_URL="https://video.bunnycdn.com"

# VdoCipher — explicit stub; not usable.
VDOCIPHER_CLIENT_ID=""
VDOCIPHER_CLIENT_SECRET=""
VDOCIPHER_BASE_URL="https://dev.vdocipher.com/api"

# Storage signing helper (R2/S3 is not part of the verified demo flow)
STORAGE_SIGNING_SECRET="replace-with-a-local-secret"

# SANAD AI evaluation engine (external service; the API calls it server-to-server)
SANAD_BASE_URL="http://localhost:8000"
SANAD_API_KEY=""
SANAD_TIMEOUT_MS="60000"

# Demo seed (used by `pnpm seed:path2`, not required by the API runtime)
DEMO_TENANT_NAME="Sanad Academy"
DEMO_TEACHER_NAME="Salih Hussein"
DEMO_TEACHER_PASSWORD="Joker-Arabic#2026"
DEMO_STUDENT_PASSWORD="Student123!"
DEMO_YOUTUBE_ID=""
# Comma-separated extra production hosts for tenant_domains seeding.
PROD_TENANT_DOMAINS=""
